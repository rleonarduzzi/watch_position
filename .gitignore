.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# The BROAD recordings are a 1.5 GB upstream dataset; fetch with
# scripts/get_broad.sh rather than vendoring them.
data/broad/

# Benchmark intermediates, regenerable with scripts/run_benchmark.py.  The
# figures under reports/figures/ are committed instead, because the reports
# embed them.  The zoomable Plotly pages are the exception: regenerate them
# with scripts/run_vicon_attitude.py and scripts/plot_vicon_quaternions.py.
reports/cache/
reports/figures/*.html

# The paper itself, retrievable from its DOI.
*.pdf
